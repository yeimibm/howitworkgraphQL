{
  "name": "biblioteca-graphql",
  "version": "1.0.0",
  "private": true,
  "description": "Servicio GraphQL de biblioteca con TypeScript, Yoga y DataLoader",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc -p tsconfig.json && node scripts/copy-schema.mjs",
    "start": "node dist/server.js",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:migrate": "tsx src/data/migrate-cli.ts",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.0.25",
    "dataloader": "^2.2.3",
    "drizzle-orm": "^0.45.3",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.15.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.12.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
