{
  "name": "biblioteca-graphql",
  "version": "1.0.0",
  "private": true,
  "description": "Servicio GraphQL de biblioteca con TypeScript, Yoga y DataLoader",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-schema.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.0.25",
    "dataloader": "^2.2.3",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.15.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
